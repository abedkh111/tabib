{
    "name": "tabib-medical-platform",
    "version": "1.0.0",
    "description": "\u0645\u0646\u0635\u0629 \u062a\u0639\u0644\u064a\u0645\u064a\u0629 \u0637\u0628\u064a\u0629 \u0634\u0627\u0645\u0644\u0629 \u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0628\u0646\u0643 \u0623\u0633\u0626\u0644\u0629 \u062a\u0641\u0627\u0639\u0644\u064a \u0648\u0643\u0648\u0631\u0633\u0627\u062a \u0623\u0648\u0646\u0644\u0627\u064a\u0646",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "hot": "vite --host",
        "watch": "vite build --watch",
        "lint": "eslint resources/js --ext .js,.vue",
        "lint:fix": "eslint resources/js --ext .js,.vue --fix",
        "format": "prettier --write resources/js/**/*.{js,vue,css}",
        "serve": "php artisan serve",
        "fresh": "php artisan migrate:fresh --seed",
        "setup": "composer install && npm install && php artisan key:generate && php artisan migrate:fresh --seed"
    },
